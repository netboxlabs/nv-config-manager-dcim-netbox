__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
# NOT `build/` -- that directory holds the NetBox image build (tracked source).
# The build backend is hatchling, which publishes to dist/; these two are the
# setuptools leftovers worth ignoring.
/build/lib/
/build/bdist.*
dist/
.venv/
venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated paths only -- build/ and deploy/ otherwise hold tracked source
# (build/versions.env + the Dockerfiles, deploy/netbox/ + deploy/configs/).
#
# Fetched helm dependencies. Chart.lock is deliberately NOT ignored: it pins the
# resolved netbox chart version so builds are reproducible.
deploy/netbox/charts/
# Workspace the air image build clones the plugin into.
.build/

# local test artifacts (may contain a token)
netbox-provider.toml

# DSX Air sim configs. docs/air-sim.md has you write one of these in the working
# directory, and it can carry an NGC API key and a NetBox token. Rooted, so a
# checked-in example under deploy/configs/ is still tracked -- the same split
# NVCM uses, which commits development/air_sim/configs/air_trial.yaml but
# ignores the working copies written next to it.
/air-trial.yaml
/air-superpod.yaml
/air-ib.yaml
/nvcm-air-sim.yaml
/.nvcm-air-sim.yaml
rd.json
out.txt
API_TOKENS
TESTING.md
# generated installer configs carry a NetBox API token
generated/

# Working notes on upstream issues, not part of the deliverable.
/NVIDIA.md

# Parity captures. The Nautobot corpus is the golden reference and IS committed;
# the NetBox side is regenerated on every run, as are the pulled artifacts.
parity/corpus/*/netbox/
parity/artifacts/

# Ship Kit production-readiness review (netboxlabs/ship-kit) -- working copy, not shipped
ship-kit/
