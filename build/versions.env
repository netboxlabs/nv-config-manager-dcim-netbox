# Upstream pins for the NetBox image build.
#
# TEMPORARY. This whole file exists only because NetBox 4.7 is unreleased and the
# plugin needs `graphql_type_extensions` (netbox commit a24fbb06c, "Enable plugins
# to extend core GraphQL API"), which is on the `feature` branch and NOT in any
# published release or image -- confirmed absent from v4.6.8-rc2.
#
# When the 4.7 beta ships and is pip-installable:
#   1. delete this file and build/netbox-image.sh
#   2. change build/netbox.Dockerfile's first line to
#      FROM ghcr.io/netbox-community/netbox:v4.7.x
# Nothing else changes -- the plugin install is deliberately its own layer.

# netbox-docker release used to build the base image. Its Dockerfile installs
# ${NETBOX_PATH}/requirements.txt, so the interpreter and dependencies come from
# the NetBox ref below rather than from a released image.
NETBOX_DOCKER_REF=5.0.2

# Exact NetBox commit on the `feature` branch. Pinned by SHA, not a tag: there is
# no 4.7 tag yet (release.yaml on `feature` still reports 4.6.6).
NETBOX_REF=4b5fc1a26066b196ca60d994f881de2ebe480b0e

# Base image tag produced by netbox-image.sh and consumed by netbox.Dockerfile.
NETBOX_BASE_IMAGE=nv-config-manager-netbox-base:feature

# netbox-bgp supplies the BGP session/peering data the fabric render path reads.
# The plugin warns at startup if it is installed but not enabled in PLUGINS.
# Matches the version running in the reference environment.
NETBOX_BGP_VERSION=0.19.0
