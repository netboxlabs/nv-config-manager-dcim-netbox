# Upstream pins for the NetBox image build.

# The published netbox-docker image the plugin image is layered on. NetBox 4.7
# is released, so this is pulled rather than built: `vX.Y.Z` tags are
# netbox-docker's own builds of that NetBox release, multi-arch (amd64 + arm64)
# and carrying the /opt/netbox/venv + uv layout netbox.Dockerfile installs into.
#
# A released tag, never a `-betaN` one: the 4.7.0 betas differ from the release
# in ways the plugin depends on (they number ipam's denormalization-trigger
# migration 0094, the release 0095), so the plugin cannot migrate on a beta.
NETBOX_BASE_IMAGE=ghcr.io/netbox-community/netbox:v4.7.0

# What NETBOX_BASE_IMAGE reports (release.yaml `version`, which is what
# PluginConfig.validate() compares against min_version). `make version-check`
# asserts it against the plugin's range.
NETBOX_VERSION=4.7.0

# netbox-bgp supplies the BGP session/peering data the fabric render path reads.
# The plugin warns at startup if it is installed but not enabled in PLUGINS.
#
# Installed from a ref, not a version: 0.19.0 (latest on PyPI) caps at NetBox
# 4.6.99, so on 4.7 NetBox warns and drops it and the render path silently loses
# BGP data. The `0.20.0` branch (0.20.0-beta1) lifts the cap to 4.7.99 and is not
# on PyPI. Back to `netbox-bgp==0.20.0` once it ships.
NETBOX_BGP_REF=da40b401055ce489d66a1a33c5d97f91100f303e

# The NetBox plugin the AIR image build layers on. `main` while the plugin and
# this provider move together; set a commit SHA to make a simulation
# reproducible, as NETBOX_BGP_REF is. Overridden entirely by pointing
# NETBOX_NVCM_PLUGIN_REPO at a local checkout.
NETBOX_PLUGIN_REF=main
